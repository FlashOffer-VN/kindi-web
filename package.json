{
  "name": "kindi-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run env && ng serve",
    "start-vite": "npm run env && ng serve --hmr=false",
    "build": "npm run env && ng build",
    "build:production": "npm run env:prod && ng build --configuration production",
    "build:vercel": "npm run env:prod && ng build --configuration production",
    "watch": "npm run env && ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "lint": "ng lint",
    "env": "node generate-env.js",
    "env:prod": "NODE_ENV=production node generate-env.js",
    "check:routes": "node scripts/check-server-routes.mjs",
    "check:globals": "node scripts/check-browser-globals.mjs",
    "check:prerender": "node scripts/smoke-prerender.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/localize": "^20.3.25",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.30",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.35",
    "@auth0/angular-jwt": "^5.2.0",
    "@ng-select/ng-select": "^23.2.0",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "@unhead/angular": "^3.4.0",
    "@unhead/shared": "^3.4.0",
    "apexcharts": "^6.10.0",
    "ng-apexcharts": "^3.1.0",
    "ngx-quill": "^30.1.3",
    "quill": "^2.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.1",
    "@angular/cli": "^20.3.1",
    "@angular/compiler-cli": "^20.3.0",
    "@tailwindcss/forms": "^0.5.7",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.0.1",
    "autoprefixer": "^10.4.20",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
